{
  appId: "com.f1simhub.companion",
  productName: "F1SimHub Companion",
  copyright: "Copyright © 2025 F1SimHub",
  icon: "resources/icon",
  directories: {
    buildResources: "resources",
    output: "dist"
  },
  // Feed for electron-updater (Windows only for now — see setupAutoUpdater
  // in main/index.ts). "generic" rather than the "github" provider
  // deliberately: the github provider expects each release's git tag to
  // BE the semver version, but this repo reuses one rolling "main"-tagged
  // release for every build (see .github/workflows/companion-release.yml).
  // A fixed download URL under that same tag stays stable across builds,
  // so electron-updater just needs latest.yml uploaded there each time —
  // no change to the existing release/tag scheme required.
  publish: {
    provider: "generic",
    url: "https://github.com/Litle-Drip/Sim-Racing-Hub/releases/download/main/"
  },
  files: [
    "!**/.vscode/*",
    "!src/*",
    "!electron.vite.config.{js,ts,mjs,cjs}",
    "!{.eslintignore,.eslintrc.cjs,.prettierignore,.prettierrc.yaml,dev-app-update.yml,CHANGELOG.md,README.md}",
    "!{.env,.env.*,.npmrc,pnpm-lock.yaml}"
  ],
  win: {
    executableName: "f1simhub-companion",
    target: [{ target: "nsis", arch: ["x64"] }]
  },
  nsis: {
    artifactName: "f1simhub-companion-${version}-setup.${ext}",
    shortcutName: "${productName}",
    uninstallDisplayName: "${productName}",
    createDesktopShortcut: "always"
  },
  mac: {
    target: [
      { target: "dmg", arch: ["universal"] }
    ],
    hardenedRuntime: false,
    entitlements: "entitlements.mac.plist",
    entitlementsInherit: "entitlements.mac.plist",
    extendInfo: [
      { NSCameraUsageDescription: "Not used." },
      { NSMicrophoneUsageDescription: "Not used." }
    ]
  },
  dmg: {
    artifactName: "f1simhub-companion-${version}-universal.${ext}"
  },
  linux: {
    target: ["AppImage", "snap", "deb"],
    maintainer: "f1simhub.com",
    category: "Utility"
  }
}
